{
    "name": "yaknet/sentinel",
    "description": "The Ultimate AI-Powered Guardian Framework for PHP. Self-healing, real-time security, and intelligent error analysis.",
    "keywords": [
        "security",
        "error-handling",
        "ai",
        "self-healing",
        "waf",
        "monitoring",
        "guardian",
        "sentinel",
        "yaknet"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "YakNet Bilişim",
            "email": "info@yakhub.com.tr"
        }
    ],
    "require": {
        "php": "^8.2",
        "google-gemini-php/client": "^1.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/mailer": "^6.4|^7.0",
        "symfony/mime": "^6.4|^7.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.8",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "YakNet\\Sentinel\\": "src/"
        }
    },
    "bin": [
        "bin/sentinel"
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
